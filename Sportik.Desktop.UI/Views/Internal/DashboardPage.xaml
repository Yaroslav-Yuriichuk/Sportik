<Page
    x:Class="Sportik.Desktop.UI.Views.Internal.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dashboard="using:Sportik.Desktop.UI.ViewModels.Dashboard"
    xmlns:converters="using:Sportik.Desktop.UI.Converters"
    xmlns:charting="using:WinRTXamlToolkit.Controls.DataVisualization.Charting"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <dashboard:DashboardViewModel />
    </Page.DataContext>

    <Page.Resources>
        <Style x:Key="RoundedColumnDataPointStyle" TargetType="charting:ColumnDataPoint">
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="charting:ColumnDataPoint">
                        <Border x:Name="Root"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Opacity="0">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8,8,0,0" />
                                <TextBlock Text="{TemplateBinding FormattedDependentValue}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top" />
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="RevealStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.001" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Shown">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Hidden">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Dashboard"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Margin="15 15 15 0"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="15 15 15 0">

            <TextBlock Text="Group by:"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0 0 15 0"
                       VerticalAlignment="Center" />

            <ComboBox MinWidth="140"
                      Margin="0 0 15 0"
                      ItemsSource="{Binding GroupingOptions}"
                      SelectedValue="{Binding SelectedGroupingOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Select:"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0 0 15 0"
                       VerticalAlignment="Center" />

            <ComboBox MinWidth="140"
                      Margin="0 0 15 0"
                      ItemsSource="{Binding TargetOptions}"
                      SelectedValue="{Binding SelectedTargetOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="2"
                Margin="15 15 15 0"
                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">

            <Grid>

                <StackPanel>
                    <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="0 0 0 10">
                        <Run Text="{Binding SelectedTargetOption.Name}" />
                        <Run Text="statistics grouped by" />
                        <Run Text="{Binding SelectedGroupingOption.Name}" />
                    </TextBlock>

                    <charting:Chart Height="400">

                        <charting:Chart.LegendStyle>
                            <Style TargetType="Control">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Height" Value="0" />
                            </Style>
                        </charting:Chart.LegendStyle>

                        <charting:Chart.Axes>

                            <charting:LinearAxis Orientation="Y"
                                                 Minimum="0">
                                <charting:LinearAxis.GridLineStyle>
                                    <Style TargetType="Line">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </charting:LinearAxis.GridLineStyle>
                                <charting:LinearAxis.AxisLabelStyle>
                                    <Style TargetType="Control">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Width" Value="0" />
                                    </Style>
                                </charting:LinearAxis.AxisLabelStyle>
                            </charting:LinearAxis>

                            <charting:CategoryAxis Orientation="X">
                                <charting:CategoryAxis.GridLineStyle>
                                    <Style TargetType="Line">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </charting:CategoryAxis.GridLineStyle>

                                <charting:CategoryAxis.MajorTickMarkStyle>
                                    <Style TargetType="Line">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </charting:CategoryAxis.MajorTickMarkStyle>
                            </charting:CategoryAxis>

                        </charting:Chart.Axes>

                        <charting:ColumnSeries Title="Weekly completed sets"
                                               IndependentValuePath="Key"
                                               DependentValuePath="Value"
                                               DataPointStyle="{StaticResource RoundedColumnDataPointStyle}"
                                               ItemsSource="{Binding BarChartData, Mode=OneWay}" />

                    </charting:Chart>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Page>
